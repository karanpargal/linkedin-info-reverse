# Required for the Voyager (full-profile) path.
# Copy from a logged-in browser AFTER loading https://www.linkedin.com/feed/
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Strongly recommended. Paste the full Cookie header from the same request
# (bcookie, lidc, li_rm, liap, _px3, …). A two-cookie jar dies fast.
# LINKEDIN_EXTRA_COOKIES=bcookie=...; lidc=...; li_rm=...; _px3=...

# Optional residential HTTPS proxy. Datacenter IPs (Railway, home NAT after a
# challenge) get HTTP 999. Still no browser — requests stay plain HTTP.
# LINKEDIN_PROXY=http://user:pass@host:port

# Optional. If set, /v1/profile requires header X-API-Key.
# API_KEY=

# Seconds between LinkedIn calls (default 3.5). Do not set this below 2.
# LINKEDIN_MIN_INTERVAL=3.5

# Cache successful profiles in memory (seconds). Default 600.
# LINKEDIN_CACHE_TTL=600
