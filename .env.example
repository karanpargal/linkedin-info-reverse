# Required for the Voyager (full-profile) path.
# Copy from a logged-in browser: DevTools → Application → Cookies → linkedin.com
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Optional. Extra cookies as a raw Cookie header (bcookie, lidc, li_rm, _px3, …).
# Improves session durability; never commit a real value.
# LINKEDIN_EXTRA_COOKIES=bcookie=...; lidc=...

# Optional. If set, /v1/profile requires header X-API-Key.
# API_KEY=

# Optional. Seconds of jitter between LinkedIn calls (default 1.2).
# LINKEDIN_MIN_INTERVAL=1.2
